# Copy this file to .env.test (gitignored) or export variables in your shell/CI.
# NEVER commit real passwords, tokens, or production credentials.

# --- Web / Playwright ---
PLAYWRIGHT_BASE_URL=http://127.0.0.1:4173
PLAYWRIGHT_HEADLESS=true
# Optional dedicated non-production test account for live Supabase web E2E tests
PLAYWRIGHT_TEST_EMAIL=
PLAYWRIGHT_TEST_PASSWORD=
# Set to 1 only for offline/isolated UI smoke verification without live Supabase auth
PLAYWRIGHT_MOCK_AUTH=0

# --- Mobile / Maestro ---
MAESTRO_APP_ID=com.anonymous.agonpreview
# Optional dedicated non-production test account for Android E2E auth flows
MAESTRO_TEST_EMAIL=
MAESTRO_TEST_PASSWORD=
MAESTRO_RUN_ID=local

# --- Backend (optional override) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_BASE_URL=
