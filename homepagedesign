/* ============================================================================
 * 1. TYPES & INTEGRATION CONTRACTS
 * Connect these props to your existing StoreProvider (useStore), ThemeProvider
 * (useTheme), and React Navigation (useNavigation) inside your screen wrapper
 * or replace the prop destructuring directly with your app hooks.
 * ============================================================================ */

export type ThemeMode = 'light' | 'dark';

export interface DashboardStoreData {
  /** Authenticated learner display name from StoreProvider */
  userName: string;
  /** Total minutes studied today from StoreProvider */
  studiedMinutesToday: number;
  /** Daily goal target in minutes from StoreProvider */
  dailyGoalMinutes: number;
  /** Active consecutive study streak in days */
  studyStreakDays: number;
  /** Number of pending tasks in Study Planner */
  pendingTaskCount: number;
  /** Optional title of the next upcoming study task */
  nextTaskTitle?: string | null;
  /** Unread notifications count for top bar badge */
  unreadNotificationCount: number;
  /** Whether Focus Lock native protection is currently enabled */
  isFocusLockEnabled: boolean;
  /** Whether a focus session timer is actively running */
  isFocusSessionActive: boolean;
  /** Formatted timer value (e.g. "25:00") from Focus Center store */
  focusTimerDisplay: string;
  /** Whether the study alarm is currently scheduled/enabled */
  isAlarmEnabled: boolean;
  /** Formatted next alarm time (e.g. "06:00 AM") or null if unconfigured */
  nextAlarmLabel?: string | null;
  /** Whether cloud sync is currently running */
  isSyncing?: boolean;
}

export interface DashboardNavigationAndServiceActions {
  /** Study Sakha logo tap -> scroll to top / return to Dashboard root */
  onPressLogo?: () => void;
  /** Cloud sync button -> triggers existing sync service */
  onTriggerSync?: () => Promise<void> | void;
  /** Theme toggle button -> calls ThemeProvider toggleTheme */
  onToggleTheme?: () => void;
  /** Notifications bell -> navigates to Notifications screen */
  onOpenNotifications: () => void;
  /** Goal Progress Dial -> navigates to Focus Center or toggles active session */
  onPressGoalDial: () => void;
  /** Add Task card -> opens Study Planner task creation flow */
  onAddTask: () => void;
  /** Focus Lock card -> toggles existing native Focus Lock service */
  onToggleFocusLock: (nextEnabled: boolean) => Promise<void> | void;
  /** Optional long-press on Focus Lock card -> opens Focus Lock settings */
  onOpenFocusLockSettings?: () => void;
  /** Focus Timer card -> opens existing Focus Center timer/settings */
  onOpenFocusTimer: () => void;
  /** Alarm card -> toggles existing Alarm Engine scheduling */
  onToggleAlarm: (nextEnabled: boolean) => Promise<void> | void;
  /** Optional long-press on Alarm card -> opens Alarm settings screen */
  onOpenAlarmSettings?: () => void;
}

export interface DashboardScreenProps {
  /** Current theme mode from ThemeProvider ('light' | 'dark') */
  themeMode?: ThemeMode;
  /** Live reactive state from StoreProvider */
  data: DashboardStoreData;
  /** Real navigation & native service callbacks */
  actions: DashboardNavigationAndServiceActions;
}

