/* ============================================================================
 * 5. PRECISION SWISS GOAL DIAL COMPONENT
 * ============================================================================ */

interface GoalDialProps {
  percent: number;
  isLive: boolean;
  palette: Palette;
  onPress: () => void;
}

const DIAL_RADIUS = 34;
const DIAL_CIRCUMFERENCE = 2 * Math.PI * DIAL_RADIUS;

const GoalDial: React.FC<GoalDialProps> = ({ percent, isLive, palette, onPress }) => {
  const clamped = Math.max(0, Math.min(100, Math.round(percent)));
  const strokeDashoffset = DIAL_CIRCUMFERENCE - (clamped / 100) * DIAL_CIRCUMFERENCE;

  return (
    <Pressable
      onPress={onPress}
      accessibilityRole="button"
      accessibilityLabel={`Daily study goal ${clamped} percent${isLive ? ', session active' : ''}`}
      style={({ pressed }) => [
        styles.dialContainer,
        pressed && styles.pressedScaleSm,
      ]}
    >
      <Svg width={80} height={80} viewBox="0 0 92 92">
        {/* Outer subtle architectural ticks */}
        <Circle
          cx={46}
          cy={46}
          r={42}
          fill="none"
          stroke={palette.dialTick}
          strokeWidth={1}
          strokeDasharray="1.5 6.75"
        />
        {/* Base Track */}
        <Circle
          cx={46}
          cy={46}
          r={DIAL_RADIUS}
          fill="none"
          stroke={palette.dialTrack}
          strokeWidth={5}
        />
        {/* Active Progress Arc rotated -90deg so 0% starts at 12 o'clock */}
        <Circle
          cx={46}
          cy={46}
          r={DIAL_RADIUS}
          fill="none"
          stroke={palette.sakha}
          strokeWidth={5}
          strokeLinecap="round"
          strokeDasharray={`${DIAL_CIRCUMFERENCE} ${DIAL_CIRCUMFERENCE}`}
          strokeDashoffset={strokeDashoffset}
          origin="46, 46"
          rotation={-90}
        />
      </Svg>

      <View style={styles.dialCenterOverlay} pointerEvents="none">
        <Text style={[styles.dialPercentText, { color: palette.inkPrimary }]}>
          {clamped}%
        </Text>
        <Text
          style={[
            styles.dialSubLabel,
            { color: isLive ? palette.sakhaDeep : palette.inkMuted },
          ]}
        >
          {isLive ? 'LIVE' : 'GOAL'}
        </Text>
      </View>
    </Pressable>
  );
};

/* ============================================================================
 * 6. MAIN REDESIGNED DASHBOARD SCREEN
 * Note: Bottom Navigation is intentionally omitted because React Navigation's
 * Bottom Tab Navigator renders Home / Library / Groups / Sakha AI / Profile.
 * ============================================================================ */

export const DashboardScreen: React.FC<DashboardScreenProps> = ({
  themeMode,
  data,
  actions,
}) => {
  const systemScheme = useColorScheme();
  const resolvedTheme: ThemeMode = themeMode ?? (systemScheme === 'dark' ? 'dark' : 'light');
  const isDark = resolvedTheme === 'dark';
  const palette = isDark ? DARK_PALETTE : LIGHT_PALETTE;

  const { width } = useWindowDimensions();
  const scrollRef = useRef<ScrollView>(null);

  // Guard rapid double-taps on native Focus Lock / Alarm toggles
  const [lockPending, setLockPending] = useState(false);
  const [alarmPending, setAlarmPending] = useState(false);

  // Subtle non-blocking feedback pill (replaces Alert)
  const [statusMessage, setStatusMessage] = useState<string | null>(null);
  const toastOpacity = useRef(new Animated.Value(0)).current;
  const toastTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null);

  const showStatusFeedback = useCallback(
    (message: string) => {
      if (toastTimerRef.current) {
        clearTimeout(toastTimerRef.current);
      }
      setStatusMessage(message);
      Animated.timing(toastOpacity, {
        toValue: 1,
        duration: 160,
        useNativeDriver: true,
      }).start();

      toastTimerRef.current = setTimeout(() => {
        Animated.timing(toastOpacity, {
          toValue: 0,
          duration: 180,
          useNativeDriver: true,
        }).start(() => setStatusMessage(null));
      }, 2000);
    },
    [toastOpacity]
  );

  // Compute responsive horizontal padding & card sizing for compact Android screens
  const isCompactWidth = width < 360;
  const horizontalPad = isCompactWidth ? 16 : 20;

  // Derived study metrics from StoreProvider
  const greeting = useMemo(() => getTimeBasedGreeting(), []);
  const goalPercent = useMemo(() => {
    if (!data.dailyGoalMinutes || data.dailyGoalMinutes <= 0) return 0;
    return Math.min(100, Math.round((data.studiedMinutesToday / data.dailyGoalMinutes) * 100));
  }, [data.studiedMinutesToday, data.dailyGoalMinutes]);

  const studiedText = useMemo(
    () => formatStudiedDuration(data.studiedMinutesToday),
    [data.studiedMinutesToday]
  );
  const streakText = useMemo(
    () => formatStreakLabel(data.studyStreakDays),
    [data.studyStreakDays]
  );

  // Safe async handlers for existing native services
  const handleLogoPress = useCallback(() => {
    scrollRef.current?.scrollTo({ y: 0, animated: true });
    actions.onPressLogo?.();
  }, [actions]);

  const handleSyncPress = useCallback(async () => {
    if (!actions.onTriggerSync) return;
    try {
      await actions.onTriggerSync();
      showStatusFeedback('Synced with cloud');
    } catch {
      showStatusFeedback('Sync failed. Try again');
    }
  }, [actions, showStatusFeedback]);

  const handleToggleFocusLock = useCallback(async () => {
    if (lockPending) return;
    const nextState = !data.isFocusLockEnabled;
    setLockPending(true);
    try {
      await actions.onToggleFocusLock(nextState);
    } catch {
      showStatusFeedback('Unable to update Focus Lock');
    } finally {
      setLockPending(false);
    }
  }, [actions, data.isFocusLockEnabled, lockPending, showStatusFeedback]);

  const handleToggleAlarm = useCallback(async () => {
    if (alarmPending) return;
    const nextState = !data.isAlarmEnabled;
    setAlarmPending(true);
    try {
      await actions.onToggleAlarm(nextState);
    } catch {
      showStatusFeedback('Unable to update Study Alarm');
    } finally {
      setAlarmPending(false);
    }
  }, [actions, data.isAlarmEnabled, alarmPending, showStatusFeedback]);

  const badgeDisplayCount =
    data.unreadNotificationCount > 99 ? '99+' : String(data.unreadNotificationCount);

  return (
    <SafeAreaView
      edges={['top']}
      style={[styles.safeArea, { backgroundColor: palette.surface }]}
    >
      <StatusBar
        barStyle={isDark ? 'light-content' : 'dark-content'}
        backgroundColor={palette.surface}
      />

      {/* Non-blocking status toast */}
      {statusMessage ? (
        <Animated.View
          pointerEvents="none"
          style={[
            styles.toastPill,
            {
              backgroundColor: palette.toastBg,
              opacity: toastOpacity,
            },
          ]}
        >
          <Text style={[styles.toastText, { color: palette.toastText }]}>
            {statusMessage}
          </Text>
        </Animated.View>
      ) : null}

      {/* ====================================================================
          SECTION 1: CLEAN TOP APP BAR
      ==================================================================== */}
      <View
        style={[
          styles.header,
          {
            paddingHorizontal: horizontalPad,
            backgroundColor: palette.surface,
            borderBottomColor: palette.hairline,
          },
        ]}
      >
        {/* Study Sakha Brand Logo -> Home / Scroll to Top */}
        <Pressable
          onPress={handleLogoPress}
          accessibilityRole="button"
          accessibilityLabel="Study Sakha Home"
          style={({ pressed }) => [styles.brandRow, pressed && styles.pressedOpacity]}
        >
          <View
            style={[
              styles.emblemBox,
              {
                backgroundColor: palette.emblemBg,
                borderColor: palette.hairline,
              },
            ]}
          >
            <StudySakhaEmblem
              leftFill={palette.emblemLeftPage}
              rightFill={palette.sakha}
            />
          </View>
          <Text style={styles.brandWordmark} numberOfLines={1}>
            <Text style={{ color: palette.inkPrimary }}>Study</Text>
            <Text style={{ color: palette.sakha }}> Sakha</Text>
          </Text>
        </Pressable>

        {/* Compact Utility Controls */}
        <View style={styles.headerActions}>
          {actions.onTriggerSync ? (
            <Pressable
              onPress={handleSyncPress}
              hitSlop={6}
              accessibilityRole="button"
              accessibilityLabel="Cloud sync status"
              style={({ pressed }) => [
                styles.iconCircleBtn,
                pressed && { backgroundColor: palette.pressHighlight },
              ]}
            >
              <CloudCheckIcon
                color={data.isSyncing ? palette.sakha : palette.iconMuted}
              />
            </Pressable>
          ) : null}

          {actions.onToggleTheme ? (
            <Pressable
              onPress={actions.onToggleTheme}
              hitSlop={6}
              accessibilityRole="button"
              accessibilityLabel="Toggle light or dark theme"
              style={({ pressed }) => [
                styles.iconCircleBtn,
                pressed && { backgroundColor: palette.pressHighlight },
              ]}
            >
              <ThemeIcon isDark={isDark} color={palette.iconMuted} />
            </Pressable>
          ) : null}

          <Pressable
            onPress={actions.onOpenNotifications}
            hitSlop={6}
            accessibilityRole="button"
            accessibilityLabel={`Notifications, ${data.unreadNotificationCount} unread`}
            style={({ pressed }) => [
              styles.iconCircleBtn,
              pressed && { backgroundColor: palette.pressHighlight },
            ]}
          >
            <BellIcon color={palette.iconMuted} />
            {data.unreadNotificationCount > 0 ? (
              <View
                style={[
                  styles.notifBadge,
                  { backgroundColor: palette.notifBadgeBg },
                ]}
              >
                <Text style={styles.notifBadgeText}>{badgeDisplayCount}</Text>
              </View>
            ) : null}
          </Pressable>
        </View>
      </View>

      {/* ====================================================================
          MAIN SCROLLABLE CANVAS
      ==================================================================== */}
      <ScrollView
        ref={scrollRef}
        style={[styles.scrollContainer, { backgroundColor: palette.canvas }]}
        contentContainerStyle={[
          styles.scrollContent,
          { paddingHorizontal: horizontalPad },
        ]}
        showsVerticalScrollIndicator={false}
      >
        {/* ==================================================================
            SECTION 2: CARDLESS EDITORIAL GREETING + GOAL DIAL + COMPACT STATS
        ================================================================== */}
        <View style={styles.focusOverviewSection}>
          <View style={styles.greetingRow}>
            <View style={styles.greetingTextWrap}>
              <Text
                style={[styles.greetingPrefix, { color: palette.inkSecondary }]}
                numberOfLines={1}
              >
                {greeting}
              </Text>
              <Text
                style={[styles.greetingName, { color: palette.inkPrimary }]}
                numberOfLines={1}
                ellipsizeMode="tail"
              >
                {data.userName}
              </Text>
            </View>

            <GoalDial
              percent={goalPercent}
              isLive={data.isFocusSessionActive}
              palette={palette}
              onPress={actions.onPressGoalDial}
            />
          </View>

          {/* Compact Study Statistics Strip */}
          <View
            style={[
