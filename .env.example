# Expo web and native client variables (safe to expose in the client bundle)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
EXPO_PUBLIC_API_BASE_URL=https://your-deployed-api.example.com

# Vercel function variables (server-only; never prefix these with EXPO_PUBLIC_)
GEMINI_API_KEY=your-gemini-api-key

# Optional server tuning
# GEMINI_REQUEST_TIMEOUT_MS=30000
# SUPABASE_AUTH_TIMEOUT_MS=10000
