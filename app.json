{
  "expo": {
    "name": "Study Sakha",
    "slug": "agon-preview",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mascot/study-sakha-mascot.png",
    "splash": {
      "image": "./assets/mascot/study-sakha-mascot.png",
      "resizeMode": "contain",
      "backgroundColor": "#111A3B"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#243B80",
        "foregroundImage": "./assets/mascot/study-sakha-mascot.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.anonymous.agonpreview"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Study Sakha",
      "shortName": "Sakha",
      "themeColor": "#243B80",
      "backgroundColor": "#F6F8FC",
      "description": "Premium exam preparation for UPSC, SSC, Banking, NEET and JEE."
    },
    "extra": {
      "eas": {
        "projectId": "98343d0d-4c2d-40f0-931d-0e0a877aeb65"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "study-sakha",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "scheme": "studysakha",
    "backgroundColor": "#F6F8FC",
    "plugins": [
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Study Sakha uses your photos to set your profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
