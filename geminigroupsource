const UnifiedChatThread = ({
  messages,
  isGroup,
  chatSearchOpen,
  chatSearchQuery,
  onChangeSearchQuery,
  onCloseSearch,
  typingUser,
  onOpenMessageActions,
  onToggleReaction,
  onPreviewAttachment,
  onToggleAttachmentBookmark,
  onDownloadAttachment,
  chatEndRef
}) => {
  const [activeMatchIdx, setActiveMatchIdx] = useState(0);

  const pinnedMessages = useMemo(
    () => messages.filter((m) => m.pinned && !m.deleted),
    [messages]
  );

  const matchingMessageIds = useMemo(() => {
    const q = chatSearchQuery.trim().toLowerCase();
    if (!q) return [];
    return messages
      .filter(
        (m) =>
          !m.deleted &&
          (m.text.toLowerCase().includes(q) ||
            (m.attachment && m.attachment.name.toLowerCase().includes(q)))
      )
      .map((m) => m.id);
  }, [messages, chatSearchQuery]);

  useEffect(() => {
    setActiveMatchIdx(0);
  }, [chatSearchQuery]);

  const scrollToMessage = (msgId) => {
    const el = document.getElementById(`msg-${msgId}`);
    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
  };

  useEffect(() => {
    if (matchingMessageIds.length > 0) {
      const targetId = matchingMessageIds[activeMatchIdx % matchingMessageIds.length];
      scrollToMessage(targetId);
    }
  }, [activeMatchIdx, matchingMessageIds]);

  const firstUnreadIndex = messages.findIndex((m) => m.isUnread && !m.deleted);
  const currentHighlightedId =
    matchingMessageIds.length > 0
      ? matchingMessageIds[activeMatchIdx % matchingMessageIds.length]
      : null;

  return (
    <div className="flex flex-1 flex-col overflow-hidden">
      {/* In-Chat Search Bar */}
      {chatSearchOpen && (
        <div className="flex items-center gap-2 border-b border-slate-200/80 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-900">
          <Search className="h-4 w-4 text-slate-400 shrink-0" />
          <input
            type="text"
            autoFocus
            value={chatSearchQuery}
            onChange={(e) => onChangeSearchQuery(e.target.value)}
            placeholder="Search messages or files..."
            className="flex-1 bg-transparent text-xs text-slate-900 placeholder:text-slate-400 focus:outline-none dark:text-white"
          />
          {chatSearchQuery.trim() && (
            <span className="text-[11px] font-semibold text-slate-400 shrink-0">
              {matchingMessageIds.length > 0
                ? `${(activeMatchIdx % matchingMessageIds.length) + 1}/${matchingMessageIds.length}`
                : '0/0'}
            </span>
          )}
          {matchingMessageIds.length > 1 && (
            <div className="flex items-center">
              <button
                onClick={() =>
                  setActiveMatchIdx((i) => (i - 1 + matchingMessageIds.length) % matchingMessageIds.length)
                }
                className="rounded p-1 text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800"
              >
                <ChevronUp className="h-3.5 w-3.5" />
              </button>
              <button
                onClick={() => setActiveMatchIdx((i) => (i + 1) % matchingMessageIds.length)}
                className="rounded p-1 text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800"
              >
                <ChevronDown className="h-3.5 w-3.5" />
              </button>
            </div>
          )}
          <button
            onClick={onCloseSearch}
            className="rounded p-1 text-slate-400 hover:text-slate-600"
          >
            <X className="h-4 w-4" />
          </button>
        </div>
      )}

      {/* Pinned Message Banner */}
      {pinnedMessages.length > 0 && (
        <button
          onClick={() => scrollToMessage(pinnedMessages[pinnedMessages.length - 1].id)}
          className="flex w-full items-center justify-between gap-2 border-b border-amber-200/70 bg-amber-50/70 px-3.5 py-2 text-left transition hover:bg-amber-50 dark:border-amber-900/50 dark:bg-amber-950/30"
        >
          <div className="flex items-center gap-2 min-w-0">
            <Pin className="h-3.5 w-3.5 shrink-0 text-amber-600 dark:text-amber-400" />
            <div className="min-w-0">
              <p className="text-[10px] font-bold uppercase tracking-wider text-amber-700 dark:text-amber-400">
                Pinned Message {pinnedMessages.length > 1 ? `(${pinnedMessages.length})` : ''}
              </p>
              <p className="truncate text-xs text-slate-700 dark:text-slate-200">
                {pinnedMessages[pinnedMessages.length - 1].text}
              </p>
            </div>
          </div>
          <ChevronRight className="h-4 w-4 shrink-0 text-amber-600/70" />
        </button>
      )}

      {/* Scrollable Messages */}
      <div className="flex-1 overflow-y-auto px-3.5 py-4 space-y-3">
        {messages.length === 0 ? (
          <div className="py-12 text-center">
            <p className="text-sm font-medium text-slate-500 dark:text-slate-400">
              No messages yet. Start the conversation!
            </p>
          </div>
        ) : (
          messages.map((msg, idx) => (
            <React.Fragment key={msg.id}>
              {idx === firstUnreadIndex && (
                <div className="my-2 flex items-center gap-3">
                  <div className="h-px flex-1 bg-teal-300/70 dark:bg-teal-800/70" />
                  <span className="rounded-full bg-teal-50 px-3 py-0.5 text-[10px] font-bold uppercase tracking-wider text-teal-700 border border-teal-200/80 dark:bg-teal-950/60 dark:text-teal-300 dark:border-teal-800">
                    Unread Messages
                  </span>
                  <div className="h-px flex-1 bg-teal-300/70 dark:bg-teal-800/70" />
                </div>
              )}
              <ChatMessageBubble
                msg={msg}
                isGroup={isGroup}
                isHighlighted={msg.id === currentHighlightedId}
                searchQuery={chatSearchOpen ? chatSearchQuery : ''}
                onOpenActions={onOpenMessageActions}
                onToggleReaction={onToggleReaction}
                onPreviewAttachment={onPreviewAttachment}
                onToggleAttachmentBookmark={onToggleAttachmentBookmark}
                onDownloadAttachment={onDownloadAttachment}
              />
            </React.Fragment>
          ))
        )}

        {/* Active-Chat-Only Typing Simulation Bubble */}
        {typingUser && (
          <div className="flex items-center gap-2">
            <Avatar initials={typingUser.initials} color={typingUser.avatarColor || 'bg-teal-600'} size="sm" />
            <div className="rounded-2xl rounded-bl-md border border-slate-200/80 bg-white px-3.5 py-2 text-xs text-slate-500 shadow-xs dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400">
              <span className="font-semibold text-slate-700 dark:text-slate-200">{typingUser.name.split(' ')[0]}</span> is typing
              <span className="ml-1 inline-flex gap-0.5">
                <span className="h-1 w-1 rounded-full bg-teal-500 animate-bounce" />
                <span className="h-1 w-1 rounded-full bg-teal-500 animate-bounce" />
                <span className="h-1 w-1 rounded-full bg-teal-500 animate-bounce" />
              </span>
            </div>
          </div>
        )}

        <div ref={chatEndRef} />
      </div>
    </div>
  );
};

