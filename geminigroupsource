      {
        id: friend.id,
        name: friend.name,
        initials: friend.initials,
        avatarColor: friend.avatarColor,
        exam: friend.exam,
        city: friend.city,
        bio: friend.bio,
        studyInterests: friend.studyInterests || [],
        groupIds: friend.groupIds || [],
        streak: friend.streak || 10,
        mutualGroups: (friend.groupIds || []).length,
        requestSent: false
