                            ? 'bg-slate-100 text-slate-400 dark:bg-slate-800'
                            : 'bg-slate-900 text-white dark:bg-teal-500 dark:text-slate-950'
                        }`}
                      >
                        {alreadyIn ? 'Joined' : 'Invite'}
                      </button>
                    </div>
                  );
                })}
              </div>
            )}
          </BottomSheet>

          {/* Invite Friends From Group Sheet */}
          <BottomSheet
            open={inviteFromGroupOpen && !!selectedGroup}
            onClose={() => setInviteFromGroupOpen(false)}
            title={`Invite Friends to ${selectedGroup?.name || ''}`}
          >
            {selectedGroup && (
              <div className="space-y-2">
                {filteredFriends.map((friend) => {
                  const alreadyIn = (friend.groupIds || []).includes(selectedGroup.id);
                  return (
                    <div
                      key={friend.id}
                      className="flex items-center justify-between rounded-2xl border border-slate-200/80 p-3 dark:border-slate-800"
                    >
                      <div className="flex items-center gap-2.5">
                        <Avatar initials={friend.initials} color={friend.avatarColor} size="sm" />
                        <div>
                          <p className="text-xs font-bold text-slate-900 dark:text-white">{friend.name}</p>
                          <p className="text-[11px] text-slate-400">{friend.exam} • {friend.city}</p>
                        </div>
                      </div>
                      <button
                        disabled={alreadyIn}
                        onClick={() => handleInviteFriendToGroup(friend, selectedGroup.id)}
                        className={`rounded-xl px-3 py-1.5 text-xs font-bold ${
                          alreadyIn
                            ? 'bg-slate-100 text-slate-400 dark:bg-slate-800'
                            : 'bg-slate-900 text-white dark:bg-teal-500 dark:text-slate-950'
                        }`}
                      >
                        {alreadyIn ? 'In Group' : 'Invite'}
                      </button>
                    </div>
                  );
                })}
              </div>
            )}
          </BottomSheet>

          {/* Remove Friend Confirmation Sheet */}
          <BottomSheet
            open={!!removeFriendTarget}
            onClose={() => setRemoveFriendTarget(null)}
            title="Remove Friend"
          >
            {removeFriendTarget && (
              <div className="space-y-4">
                <p className="text-xs text-slate-600 dark:text-slate-300">
                  Remove <strong>{removeFriendTarget.name}</strong> from your friends list? You can always send a new request later.
                </p>
                <div className="grid grid-cols-2 gap-2">
                  <button
                    onClick={() => setRemoveFriendTarget(null)}
                    className="rounded-xl border border-slate-200 py-2.5 text-xs font-bold text-slate-600 dark:border-slate-700 dark:text-slate-300"
                  >
                    Cancel
                  </button>
                  <button
                    onClick={handleConfirmRemoveFriend}
                    className="rounded-xl bg-rose-600 py-2.5 text-xs font-bold text-white"
                  >
                    Remove
                  </button>
                </div>
              </div>
            )}
          </BottomSheet>

          {/* Report User / Message & Block Sheet */}
          <BottomSheet
            open={!!reportTarget}
            onClose={() => {
              setReportTarget(null);
              setReportDetails('');
            }}
            title={`Safety Options • ${reportTarget?.type === 'message' ? 'Report Message' : reportTarget?.name || ''}`}
          >
            {reportTarget && (
              <form onSubmit={handleSubmitReport} className="space-y-3.5">
                {reportTarget.snippet && (
                  <div className="rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs text-slate-600 dark:border-slate-800 dark:bg-slate-800/60 dark:text-slate-300">
                    <p className="text-[10px] font-bold uppercase text-slate-400">Reported Message</p>
                    <p className="mt-1 italic">“{reportTarget.snippet}”</p>
                  </div>
                )}

                <div className="space-y-1.5">
                  <label className="text-xs font-bold text-slate-600 dark:text-slate-300">Select Reason</label>
                  {REPORT_REASONS.map((reason) => (
                    <button
                      type="button"
                      key={reason}
                      onClick={() => setReportReason(reason)}
                      className={`flex w-full items-center justify-between rounded-xl border px-3 py-2 text-left text-xs font-semibold transition ${
                        reportReason === reason
                          ? 'border-teal-500 bg-teal-50/60 text-teal-800 dark:bg-teal-950/40 dark:text-teal-200'
                          : 'border-slate-200 text-slate-600 dark:border-slate-800 dark:text-slate-300'
                      }`}
                    >
                      <span>{reason}</span>
                      {reportReason === reason && <Check className="h-3.5 w-3.5 text-teal-600" />}
                    </button>
                  ))}
                </div>

                <div>
                  <label className="text-xs font-bold text-slate-600 dark:text-slate-300">Additional Context (Optional)</label>
                  <textarea
                    rows={2}
                    value={reportDetails}
                    onChange={(e) => setReportDetails(e.target.value)}
                    placeholder="Add brief details for community moderators..."
                    className="mt-1 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  />
                </div>

                <div className="space-y-2">
                  <button
                    type="submit"
                    className="flex w-full items-center justify-center gap-2 rounded-xl bg-amber-500 py-2.5 text-xs font-bold text-slate-950 hover:bg-amber-400"
                  >
                    <Flag className="h-4 w-4" />
                    Submit Report
                  </button>
                  {reportTarget.type === 'user' && (
                    <button
                      type="button"
                      onClick={() => handleBlockUser(reportTarget)}
                      className="flex w-full items-center justify-center gap-2 rounded-xl border border-rose-200 bg-rose-50 py-2.5 text-xs font-bold text-rose-600 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-400"
                    >
                      <Ban className="h-4 w-4" />
                      Block {reportTarget.name}
                    </button>
                  )}
                </div>
              </form>
            )}
          </BottomSheet>

          {/* Notification Preferences & Quiet Hours Sheet */}
          <BottomSheet
            open={notifPrefsOpen}
            onClose={() => setNotifPrefsOpen(false)}
            title="Notification Preferences"
          >
            <div className="space-y-4">
              {[
                { key: 'friendRequests', label: 'Friend Requests & Accepts', sub: 'New connection requests from aspirants' },
                { key: 'groupActivity', label: 'Group Polls, Notes & Goals', sub: 'Updates from your joined study groups' },
                { key: 'personalChats', label: 'Personal 1-on-1 Messages', sub: 'Direct messages from friends' },
                { key: 'studyNudges', label: 'Study Partner Nudges', sub: 'Accountability check-ins & reminders' }
              ].map((item) => (
                <div key={item.key} className="flex items-center justify-between gap-3">
                  <div>
                    <p className="text-xs font-bold text-slate-900 dark:text-white">{item.label}</p>
                    <p className="text-[11px] text-slate-500">{item.sub}</p>
                  </div>
                  <button
                    onClick={() => setNotifPrefs((p) => ({ ...p, [item.key]: !p[item.key] }))}
                    className={`h-6 w-11 rounded-full p-0.5 transition shrink-0 ${
                      notifPrefs[item.key] ? 'bg-teal-500' : 'bg-slate-300 dark:bg-slate-700'
                    }`}
                  >
                    <div
                      className={`h-5 w-5 rounded-full bg-white shadow transition-transform ${
                        notifPrefs[item.key] ? 'translate-x-5' : 'translate-x-0'
                      }`}
                    />
                  </button>
                </div>
              ))}

              {/* Quiet Hours Configuration */}
              <div className="rounded-2xl border border-indigo-200/70 bg-indigo-50/50 p-3.5 space-y-3 dark:border-indigo-900/50 dark:bg-indigo-950/20">
                <div className="flex items-center justify-between gap-3">
                  <div>
                    <p className="flex items-center gap-1.5 text-xs font-bold text-indigo-900 dark:text-indigo-200">
                      <BellOff className="h-3.5 w-3.5" />
                      Quiet Hours (Deep Focus / Sleep)
                    </p>
                    <p className="text-[11px] text-indigo-700/80 dark:text-indigo-300/80">
                      Mute community notifications during study or rest
                    </p>
                  </div>
                  <button
                    onClick={() =>
                      setNotifPrefs((p) => ({ ...p, quietHoursEnabled: !p.quietHoursEnabled }))
                    }
                    className={`h-6 w-11 rounded-full p-0.5 transition shrink-0 ${
                      notifPrefs.quietHoursEnabled ? 'bg-indigo-600' : 'bg-slate-300 dark:bg-slate-700'
                    }`}
                  >
                    <div
                      className={`h-5 w-5 rounded-full bg-white shadow transition-transform ${
                        notifPrefs.quietHoursEnabled ? 'translate-x-5' : 'translate-x-0'
                      }`}
                    />
                  </button>
                </div>

                {notifPrefs.quietHoursEnabled && (
                  <div className="grid grid-cols-2 gap-2.5">
                    <div>
                      <label className="text-[10px] font-bold uppercase text-indigo-700 dark:text-indigo-300">Start</label>
                      <input
                        type="time"
                        value={notifPrefs.quietStart}
                        onChange={(e) => setNotifPrefs((p) => ({ ...p, quietStart: e.target.value }))}
                        className="mt-1 w-full rounded-xl border border-indigo-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-900 dark:border-indigo-800 dark:bg-slate-900 dark:text-white"
                      />
                    </div>
                    <div>
                      <label className="text-[10px] font-bold uppercase text-indigo-700 dark:text-indigo-300">End</label>
                      <input
                        type="time"
                        value={notifPrefs.quietEnd}
                        onChange={(e) => setNotifPrefs((p) => ({ ...p, quietEnd: e.target.value }))}
                        className="mt-1 w-full rounded-xl border border-indigo-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-900 dark:border-indigo-800 dark:bg-slate-900 dark:text-white"
                      />
                    </div>
                  </div>
                )}
              </div>
            </div>
          </BottomSheet>

          {/* Privacy & Safety Settings Sheet */}
          <BottomSheet
            open={privacyModalOpen}
            onClose={() => setPrivacyModalOpen(false)}
            title="Privacy & Safety"
          >
            <div className="space-y-4">
              {[
                { key: 'allowFriendRequests', label: 'Allow Friend Requests', sub: 'Students in your exam track can connect' },
                { key: 'showOnlineStatus', label: 'Show Online Indicator', sub: 'Visible only to your accepted friends' },
                { key: 'allowGroupInvites', label: 'Allow Group Invites', sub: 'Friends can add you to study groups' },
                { key: 'discoverableInSearch', label: 'Appear in Find Students', sub: 'Let RAS/UPSC/SSC/RSSB peers discover your profile' }
              ].map((item) => (
                <div key={item.key} className="flex items-center justify-between gap-3">
                  <div>
                    <p className="text-xs font-bold text-slate-900 dark:text-white">{item.label}</p>
                    <p className="text-[11px] text-slate-500">{item.sub}</p>
                  </div>
                  <button
                    onClick={() =>
                      setPrivacySettings((p) => ({ ...p, [item.key]: !p[item.key] }))
                    }
                    className={`h-6 w-11 rounded-full p-0.5 transition shrink-0 ${
                      privacySettings[item.key] ? 'bg-teal-500' : 'bg-slate-300 dark:bg-slate-700'
                    }`}
                  >
                    <div
                      className={`h-5 w-5 rounded-full bg-white shadow transition-transform ${
                        privacySettings[item.key] ? 'translate-x-5' : 'translate-x-0'
                      }`}
                    />
                  </button>
                </div>
              ))}

              <div className="border-t border-slate-200 pt-3 dark:border-slate-800">
                <p className="text-xs font-bold uppercase tracking-wider text-slate-500">
                  Blocked Users ({blockedUsers.length})
                </p>
                {blockedUsers.length === 0 ? (
                  <p className="mt-1.5 text-xs text-slate-400">No blocked users.</p>
                ) : (
                  <div className="mt-2 space-y-2">
                    {blockedUsers.map((u) => (
                      <div
                        key={u.id}
                        className="flex items-center justify-between rounded-xl border border-slate-200 p-2.5 dark:border-slate-800"
                      >
                        <div>
                          <span className="text-xs font-bold text-slate-800 dark:text-slate-200">{u.name}</span>
                          {u.exam && <span className="ml-2 text-[10px] text-slate-400">{u.exam}</span>}
                        </div>
                        <button
                          onClick={() => handleUnblockUser(u.id)}
                          className="text-xs font-bold text-teal-600 dark:text-teal-400"
                        >
                          Unblock
                        </button>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </BottomSheet>
        </div>
      </div>
    </div>
  );
}

export default function App() {
  return (
    <ErrorBoundary>
      <StudySakhaApp />
    </ErrorBoundary>
  );
}
