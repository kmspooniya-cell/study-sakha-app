      replyTo: replyingTo
        ? {
            id: replyingTo.id,
            senderName: replyingTo.sender === 'me' ? CURRENT_USER.name : selectedFriend.name,
            text: replyingTo.text
          }
        : undefined,
      attachment: customAttachment || undefined
    };
    setFriends((prev) =>
      prev.map((f) =>
        f.id === selectedFriend.id
          ? { ...f, messages: [...f.messages.map((m) => ({ ...m, isUnread: false })), newMsg] }
          : f
      )
    );
    setDmMsgInput('');
    setReplyingTo(null);
    if (customAttachment) showToast('Attachment sent');
    triggerActiveChatTypingReply('dm', selectedFriend.id);
  };

  const handleAcceptRequest = (req) => {
    const newFriend = {
      id: req.userId,
      name: req.name,
      initials: req.initials,
      avatarColor: req.avatarColor,
      exam: req.exam,
      city: req.city,
      bio: req.bio || `${req.exam} aspirant on Study Sakha.`,
      studyInterests: req.studyInterests || [req.exam],
      groupIds: req.groupIds || [],
      online: true,
      isStudyPartner: false,
      streak: req.streak || 12,
      todayGoal: '4/8 hrs completed',
      lastSeen: 'Online',
      messages: [
        {
          id: `dm-acc-${Date.now()}`,
          sender: 'them',
          senderId: req.userId,
          senderName: req.name,
          senderInitials: req.initials,
          text: req.note || 'Thanks for accepting my request! Let’s prepare well.',
          time: 'Just now'
        }
      ]
    };
    setFriends((prev) => [newFriend, ...prev]);
    setRequests((prev) => prev.filter((r) => r.id !== req.id));
    showToast(`You and ${req.name} are now friends!`);
  };

  const handleDeclineRequest = (req) => {
    setRequests((prev) => prev.filter((r) => r.id !== req.id));
