      {
        id: req.userId,
        name: req.name,
        initials: req.initials,
        avatarColor: req.avatarColor,
        exam: req.exam,
        city: req.city,
        bio: req.bio || `${req.exam} aspirant.`,
        studyInterests: req.studyInterests || [req.exam],
        groupIds: req.groupIds || [],
        streak: req.streak || 10,
        mutualGroups: (req.groupIds || []).length,
        requestSent: false
      },
      ...prev
    ]);
    showToast(`Declined request from ${req.name}`);
  };

  const handleToggleSendRequest = (studentId) => {
    setDiscover((prev) =>
      prev.map((d) => {
        if (d.id !== studentId) return d;
        const nextSent = !d.requestSent;
        showToast(nextSent ? `Friend request sent to ${d.name}` : `Cancelled request to ${d.name}`);
        return { ...d, requestSent: nextSent };
