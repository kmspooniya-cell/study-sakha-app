const QUICK_REACTIONS = ['👍', '❤️', '🔥', '🎯', '👏'];

const HighlightedText = ({ text, query }) => {
  if (!query || !query.trim()) return text;
  const safeQuery = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const parts = text.split(new RegExp(`(${safeQuery})`, 'gi'));
  return parts.map((part, idx) =>
    part.toLowerCase() === query.toLowerCase() ? (
      <mark key={idx} className="rounded bg-amber-300/80 px-0.5 text-slate-900 dark:bg-amber-400 dark:text-slate-950">
        {part}
      </mark>
    ) : (
      <React.Fragment key={idx}>{part}</React.Fragment>
    )
  );
};

const ChatMessageBubble = ({
  msg,
  isGroup,
  isHighlighted,
  searchQuery,
  onOpenActions,
  onToggleReaction,
  onPreviewAttachment,
  onToggleAttachmentBookmark,
  onDownloadAttachment
}) => {
  const isMe = msg.senderId === 'me' || msg.sender === 'me';
  const reactions = msg.reactions || {};
  const reactionEntries = Object.entries(reactions).filter(([, users]) => users.length > 0);

  return (
    <div
      id={`msg-${msg.id}`}
      className={`group flex items-end gap-2 transition-colors rounded-2xl px-1 py-0.5 ${
        isMe ? 'justify-end' : 'justify-start'
      } ${isHighlighted ? 'bg-teal-500/15 ring-1 ring-teal-400/50' : ''}`}
    >
      {!isMe && isGroup && (
        <Avatar
          initials={msg.senderInitials || 'AS'}
          color={msg.avatarColor || 'bg-blue-900'}
          size="sm"
        />
      )}

      <div className={`relative max-w-[82%] ${isMe ? 'items-end' : 'items-start'} flex flex-col`}>
        {/* Bubble Surface */}
        <div
          onClick={() => !msg.deleted && onOpenActions(msg)}
          className={`relative cursor-pointer rounded-2xl px-3.5 py-2.5 shadow-xs transition active:scale-[0.99] ${
            msg.deleted
              ? 'border border-dashed border-slate-300 bg-slate-100/70 text-slate-400 italic dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-500'
              : isMe
              ? isGroup
                ? 'bg-slate-200/95 text-slate-900 rounded-br-md dark:bg-slate-800 dark:text-slate-100'
                : 'bg-slate-900 text-white rounded-br-md dark:bg-teal-600 dark:text-white'
              : 'bg-white text-slate-900 border border-slate-200/80 rounded-bl-md dark:bg-slate-900 dark:border-slate-800 dark:text-slate-100'
          }`}
        >
          {/* Top metadata row: Sender name (group) + Pin / Bookmark badges */}
          {!msg.deleted && ((!isMe && isGroup) || msg.pinned || msg.bookmarked) && (
            <div className="mb-1 flex items-center justify-between gap-2">
              {!isMe && isGroup ? (
                <p className="text-[11px] font-bold text-slate-700 dark:text-teal-400">
                  {msg.senderName}
                </p>
              ) : (
                <span />
              )}
              <div className="flex items-center gap-1">
                {msg.pinned && (
                  <Pin
                    className={`h-3 w-3 ${
                      isMe && !isGroup ? 'text-teal-200' : 'text-amber-500'
                    }`}
                  />
                )}
                {msg.bookmarked && (
                  <Bookmark
                    className={`h-3 w-3 fill-current ${
                      isMe && !isGroup ? 'text-teal-200' : 'text-teal-500'
                    }`}
                  />
                )}
              </div>
            </div>
          )}

          {/* Quoted Reply Block */}
          {!msg.deleted && msg.replyTo && (
            <div
              className={`mb-2 rounded-xl border-l-2 px-2.5 py-1.5 text-[11px] ${
                isMe && !isGroup
                  ? 'border-teal-300 bg-white/10 text-slate-200'
                  : 'border-teal-500 bg-slate-100/90 text-slate-600 dark:bg-slate-950/60 dark:text-slate-300'
              }`}
            >
              <p className="font-bold leading-tight">{msg.replyTo.senderName}</p>
              <p className="truncate opacity-85">{msg.replyTo.text}</p>
            </div>
          )}

          {/* Message Body */}
          {msg.deleted ? (
            <p className="text-xs">This message was deleted</p>
          ) : (
            <p className="text-[13.5px] leading-relaxed break-words">
              <HighlightedText text={msg.text} query={searchQuery} />
            </p>
          )}

          {/* Attachment Card (PDF / IMG) */}
          {!msg.deleted && msg.attachment && (
            <div
              onClick={(e) => e.stopPropagation()}
              className="mt-2.5 flex items-center justify-between gap-2.5 rounded-xl bg-white/95 p-2.5 border border-slate-200/80 text-slate-800 dark:bg-slate-950/80 dark:border-slate-700 dark:text-slate-100"
            >
              <div className="flex items-center gap-2.5 min-w-0">
                <div
                  className={`flex h-9 w-9 shrink-0 items-center justify-center rounded-lg ${
                    msg.attachment.type === 'IMG'
                      ? 'bg-sky-50 text-sky-600 dark:bg-sky-950/60 dark:text-sky-400'
                      : 'bg-rose-50 text-rose-500 dark:bg-rose-950/60 dark:text-rose-400'
                  }`}
                >
                  {msg.attachment.type === 'IMG' ? (
                    <ImageIcon className="h-4 w-4" />
                  ) : (
                    <FileText className="h-4 w-4" />
                  )}
                </div>
                <div className="min-w-0">
                  <p className="truncate text-xs font-bold">{msg.attachment.name}</p>
                  <p className="text-[10px] text-slate-400">
                    {msg.attachment.type} • {msg.attachment.size}
                  </p>
                </div>
              </div>
              <div className="flex items-center gap-0.5 shrink-0 text-slate-500 dark:text-slate-400">
                <button
                  onClick={() => onPreviewAttachment(msg.attachment)}
                  className="rounded-lg p-1.5 hover:bg-slate-100 dark:hover:bg-slate-800"
                  title="Preview"
                >
                  <Eye className="h-4 w-4" />
                </button>
                <button
                  onClick={() => onToggleAttachmentBookmark(msg.attachment.id)}
                  className={`rounded-lg p-1.5 hover:bg-slate-100 dark:hover:bg-slate-800 ${
                    msg.attachment.bookmarked ? 'text-teal-600 dark:text-teal-400' : ''
                  }`}
                  title="Bookmark"
                >
                  <Bookmark className={`h-4 w-4 ${msg.attachment.bookmarked ? 'fill-current' : ''}`} />
                </button>
                <button
                  onClick={() => onDownloadAttachment(msg.attachment)}
                  className="rounded-lg p-1.5 hover:bg-slate-100 dark:hover:bg-slate-800"
                  title="Download"
                >
                  <Download className="h-4 w-4" />
                </button>
              </div>
            </div>
          )}

          {/* Footer: Edited + Time + Simplified Delivery Status */}
          {!msg.deleted && (
            <div
              className={`mt-1 flex items-center justify-end gap-1 text-[10px] ${
                isMe && !isGroup ? 'text-slate-300 dark:text-teal-100' : 'text-slate-500 dark:text-slate-400'
              }`}
            >
              {msg.edited && <span className="italic opacity-80">edited</span>}
              <span>{msg.time}</span>
              {isMe &&
                (msg.status === 'read' ? (
                  <CheckCheck
                    className={`h-3.5 w-3.5 ${
                      !isGroup ? 'text-teal-300 dark:text-white' : 'text-teal-600 dark:text-teal-400'
                    }`}
                  />
                ) : (
                  <Check className="h-3.5 w-3.5 opacity-75" />
                ))}
            </div>
          )}
        </div>

        {/* Emoji Reaction Pills */}
        {!msg.deleted && reactionEntries.length > 0 && (
          <div className={`mt-1 flex flex-wrap gap-1 ${isMe ? 'justify-end' : 'justify-start'}`}>
            {reactionEntries.map(([emoji, users]) => {
              const reactedByMe = users.includes('me');
              return (
                <button
                  key={emoji}
                  onClick={() => onToggleReaction(msg.id, emoji)}
                  className={`inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-[11px] font-semibold shadow-2xs transition ${
                    reactedByMe
                      ? 'border-teal-400 bg-teal-50 text-teal-800 dark:border-teal-600 dark:bg-teal-950/70 dark:text-teal-200'
                      : 'border-slate-200 bg-white text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300'
                  }`}
                >
                  <span>{emoji}</span>
                  <span>{users.length}</span>
                </button>
              );
            })}
          </div>
        )}
      </div>
    </div>
  );
};

