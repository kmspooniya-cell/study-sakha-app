  const handleInviteFriendToGroup = (friend, groupId) => {
    const group = groups.find((g) => g.id === groupId);
    if (!group) return;
    if ((friend.groupIds || []).includes(groupId)) {
      showToast(`${friend.name} is already in ${group.name}`);
      return;
