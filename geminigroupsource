    setFriends((prev) =>
      prev.map((f) => (f.id === friend.id ? { ...f, groupIds: [...(f.groupIds || []), groupId] } : f))
    );

    setGroups((prev) =>
      prev.map((g) => {
        if (g.id !== groupId) return g;
        const generalMsgs = g.messages['general-chat'] || [];
        const alreadyListed = (g.members || []).some((m) => m.id === friend.id);
        return {
          ...g,
          membersCount: g.membersCount + 1,
          members: alreadyListed
