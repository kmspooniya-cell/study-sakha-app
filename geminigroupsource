    setGroups((prev) =>
      prev.map((g) => {
        if (g.id !== groupId) return g;
        return {
          ...g,
          polls: g.polls.map((p) => {
            if (p.id !== pollId || p.status === 'closed') return p;
            const prevVoted = p.votedOptionIds || [];
            let nextVoted = [];

            if (p.allowMultiple) {
              nextVoted = prevVoted.includes(optionId)
                ? prevVoted.filter((id) => id !== optionId)
                : [...prevVoted, optionId];
            } else {
              nextVoted = prevVoted.includes(optionId) ? [] : [optionId];
            }

            return {
              ...p,
              votedOptionIds: nextVoted,
              options: p.options.map((opt) => {
                const wasSelected = prevVoted.includes(opt.id);
                const isSelected = nextVoted.includes(opt.id);
                let votes = opt.votes;
                let voters = [...(opt.voters || [])];

                if (wasSelected && !isSelected) {
                  votes = Math.max(0, votes - 1);
                  voters = voters.filter((v) => v !== CURRENT_USER.name);
                } else if (!wasSelected && isSelected) {
                  votes += 1;
                  if (!voters.includes(CURRENT_USER.name)) voters = [CURRENT_USER.name, ...voters];
                }
                return { ...opt, votes, voters };
              })
            };
          })
        };
      })
    );
  };

